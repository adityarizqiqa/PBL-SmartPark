# Salin menjadi .env lalu sesuaikan bila perlu.

APP_NAME="SmartPark API"
APP_ENV=development
DEBUG=true

# Alamat dengar server. 0.0.0.0 wajib bila aplikasi mobile dijalankan di
# perangkat fisik: dengan 127.0.0.1 server hanya menerima koneksi dari mesin
# ini sendiri, sehingga perangkat di Wi-Fi yang sama selalu ditolak.
HOST=0.0.0.0
PORT=8000

# SQLite untuk tahap pengembangan. Ganti ke MySQL saat produksi.
DATABASE_URL=sqlite:///./smartpark.db

# Zona waktu untuk batas hari laporan. Waktu di database selalu UTC.
REPORT_TIMEZONE=Asia/Jakarta
REPORT_UTC_OFFSET_HOURS=7

# Pencocokan plat: kandidat ditampilkan bila jarak edit <= nilai ini.
PLATE_SIMILAR_MAX_DISTANCE=1
PLATE_MAX_LENGTH=12

# NIM: angka saja, panjang bebas dalam rentang ini.
# NIM_MAX_LENGTH tidak boleh melebihi lebar kolom nim di database (32).
NIM_MIN_LENGTH=1
NIM_MAX_LENGTH=32

# Autentikasi petugas
PASSWORD_MIN_LENGTH=6
TOKEN_BYTES=32
PIN_MAX_ATTEMPTS_PER_MINUTE=5

# Penyimpanan snapshot plat
UPLOAD_DIR=./storage/plates
UPLOAD_MAX_BYTES=5242880
